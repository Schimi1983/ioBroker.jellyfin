{
    "i18n": true,
    "type": "panel",
    "items": {
        "_headerGuide": {
            "type": "header",
            "size": 4,
            "text": "header_guide",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_textGuide": {
            "type": "staticText",
            "text": "text_guide",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_linkGuide": {
            "type": "staticLink",
            "text": "link_guide",
            "href": "https://github.com/Schimi1983/ioBroker.jellyfin#readme",
            "button": true,
            "variant": "outlined",
            "icon": "book",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerConnection": {
            "type": "header",
            "size": 4,
