            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "url": {
            "type": "text",
            "label": "label_url",
            "help": "help_url",
            "validator": "!!data.url && data.url.trim().length > 0",
            "validatorErrorText": "error_url",
            "validatorNoSaveOnError": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "apiKey": {
            "type": "password",
            "label": "label_apiKey",
            "help": "help_apiKey",
            "visible": true,
            "validator": "!!data.apiKey && data.apiKey.trim().length > 0",
            "validatorErrorText": "error_apiKey",
            "validatorNoSaveOnError": true,
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerOptions": {
            "type": "header",
            "size": 4,
            "text": "header_options",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "onlyRemoteControllable": {
            "type": "checkbox",
            "label": "label_onlyRemote",
            "help": "help_onlyRemote",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "updateInterval": {
            "type": "number",
            "label": "label_updateInterval",
            "help": "help_updateInterval",
            "min": 2,
            "max": 60,
