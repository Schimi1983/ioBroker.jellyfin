            "expertMode": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "coverHeight": {
            "type": "number",
            "label": "label_coverHeight",
            "help": "help_coverHeight",
            "min": 0,
            "max": 2000,
            "unit": "px",
            "newLine": true,
            "expertMode": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "requestTimeout": {
            "type": "number",
            "label": "label_requestTimeout",
            "help": "help_requestTimeout",
            "min": 2,
            "max": 60,
            "unit": "s",
            "newLine": true,
            "expertMode": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_headerSupport": {
            "type": "header",
            "size": 4,
            "text": "header_support",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_textSupport": {
            "type": "staticText",
            "text": "support_text",
            "newLine": true,
